rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedProdUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.isArchived != true;
    }

    function isAuthorizedTestUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/test_teamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/test_teamMembers/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/test_teamMembers/$(request.auth.uid)).data.isArchived != true;
    }

    match /private_member_credentials/{document=**} {
      allow read, write: if false;
    }

    match /private_sessions/{document=**} {
      allow read, write: if false;
    }

    match /test_private_member_credentials/{document=**} {
      allow read, write: if false;
    }

    match /test_private_sessions/{document=**} {
      allow read, write: if false;
    }

    match /private_google_calendar_auth/{document=**} {
      allow read, write: if false;
    }

    match /test_private_google_calendar_auth/{document=**} {
      allow read, write: if false;
    }

    match /teamMembers/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_teamMembers/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /events/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_events/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /assignments/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_assignments/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /assignmentLabels/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_assignmentLabels/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /checklist_items/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_checklist_items/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /checklist_presets/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_checklist_presets/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /tasks/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_tasks/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    // Team tasks ("משימות"). request.auth.uid is the team member's document id
    // (the backend's /auth/login mints the custom token with it). Managers
    // (admin or "ניהול משימות", read from the member document since
    // canManageTasks is not a token claim) read every task; any other member
    // reads only the tasks whose ownerIds hold their id, so a non-manager's
    // screen must query `ownerIds array-contains <me>`.
    function isTeamTaskManager(membersPath) {
      let member = get(/databases/$(database)/documents/$(membersPath)/$(request.auth.uid)).data;
      return member.isAdmin == true || member.canManageTasks == true;
    }

    // A member tagged ("@") in a task's log reads it too (19/11/2026).
    match /teamTasks/{taskId} {
      allow read: if isAuthorizedProdUser()
        && (isTeamTaskManager('teamMembers') || request.auth.uid in resource.data.ownerIds
          || request.auth.uid in resource.data.mentionIds);
      allow write: if false;
    }

    match /test_teamTasks/{taskId} {
      allow read: if isAuthorizedTestUser()
        && (isTeamTaskManager('test_teamMembers') || request.auth.uid in resource.data.ownerIds
          || request.auth.uid in resource.data.mentionIds);
      allow write: if false;
    }

    match /stages/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_stages/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /calendar_sync/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_calendar_sync/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /event_calendar_sync/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_event_calendar_sync/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    // Global, NOT environment-scoped: roles, categories and vehicle lists are
    // shared by both environments on purpose (see db_preview_screen's
    // "כלים (גלובלי)" / useEnvironmentPrefix: false). Test users must be able
    // to read it too — their uid comes from test_teamMembers and so never
    // satisfies isAuthorizedProdUser(), which used to deny roles and
    // categories to every test-mode session.
    match /utilities/{document=**} {
      allow read: if isAuthorizedProdUser() || isAuthorizedTestUser();
      allow write: if false;
    }

    match /test_utilities/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /logs/{document=**} {
      allow read: if isAuthorizedProdUser();
      allow write: if false;
    }

    match /test_logs/{document=**} {
      allow read: if isAuthorizedTestUser();
      allow write: if false;
    }

    match /keys/{document=**} {
      allow read, write: if false;
    }

    match /test_keys/{document=**} {
      allow read, write: if false;
    }

    // Web Push subscriptions: only the API reads and writes them.
    match /pushSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /test_pushSubscriptions/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
